# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
CMPM125_FinalProject/.utmp/
CMPM125_FinalProject/[Ll]ibrary/
CMPM125_FinalProject/[Tt]emp/
CMPM125_FinalProject/[Oo]bj/
CMPM125_FinalProject/[Bb]uild/
CMPM125_FinalProject/[Bb]uilds/
CMPM125_FinalProject/[Ll]ogs/
CMPM125_FinalProject/[Uu]ser[Ss]ettings/
CMPM125_FinalProject/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
CMPM125_FinalProject/*.blend1
CMPM125_FinalProject/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
CMPM125_FinalProject/[Mm]emoryCaptures/

# Recordings can get excessive in size
CMPM125_FinalProject/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# CMPM125_FinalProject/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
CMPM125_FinalProject/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
CMPM125_FinalProject/*.DotSettings.user

# Visual Studio cache directory
CMPM125_FinalProject/.vs/

# Gradle cache directory
CMPM125_FinalProject/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
CMPM125_FinalProject/ExportedObj/
CMPM125_FinalProject/.consulo/
CMPM125_FinalProject/*.csproj
CMPM125_FinalProject/*.unityproj
CMPM125_FinalProject/*.sln
CMPM125_FinalProject/*.slnx
CMPM125_FinalProject/*.suo
CMPM125_FinalProject/*.tmp
CMPM125_FinalProject/*.user
CMPM125_FinalProject/*.userprefs
CMPM125_FinalProject/*.pidb
CMPM125_FinalProject*.booproj
CMPM125_FinalProject/*.svd
CMPM125_FinalProject/*.pdb
CMPM125_FinalProject/*.mdb
CMPM125_FinalProject/*.opendb
CMPM125_FinalProject/*.VC.db

# Unity3D generated meta files
CMPM125_FinalProject/*.pidb.meta
CMPM125_FinalProject/*.pdb.meta
CMPM125_FinalProject/*.mdb.meta

# Unity3D generated file on crash reports
CMPM125_FinalProject/sysinfo.txt

# Mono auto generated files
CMPM125_FinalProject/mono_crash.*

# Builds
CMPM125_FinalProject/*.apk
CMPM125_FinalProject/*.aab
CMPM125_FinalProject/*.unitypackage
CMPM125_FinalProject/*.unitypackage.meta
CMPM125_FinalProject/*.app

# Crashlytics generated file
CMPM125_FinalProject/crashlytics-build.properties

# TestRunner generated files
CMPM125_FinalProject/InitTestScene*.unity*

# Addressables default ignores, before user customizations
CMPM125_FinalProject/ServerData
CMPM125_FinalProject/[Aa]ssets/StreamingAssets/aa*
CMPM125_FinalProject/[Aa]ssets/AddressableAssetsData/link.xml*
CMPM125_FinalProject/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
CMPM125_FinalProject/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
CMPM125_FinalProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
CMPM125_FinalProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
CMPM125_FinalProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
CMPM125_FinalProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
CMPM125_FinalProject/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
CMPM125_FinalProject/UIElementsSchema/

# Auto-generated cache in Assets folder
CMPM125_FinalProject/[Aa]ssets/[Ss]ceneDependencyCache*
CMPM125_FinalProject/.vscode/extensions.json
CMPM125_FinalProject/.vscode/launch.json
CMPM125_FinalProject/.vscode/settings.json